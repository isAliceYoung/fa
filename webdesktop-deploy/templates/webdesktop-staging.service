[Unit]
Description=WebDesktop pinned staging backend
Requires=webdesktop-guest.socket
After=postgresql@15-main.service webdesktop-guest.socket
[Service]
User=wdsvc
Group=wdsvc
WorkingDirectory=/opt/webdesktop/app
ExecStart=/usr/bin/env -i HOME=/var/lib/webdesktop USER=wdsvc LOGNAME=wdsvc PATH=/usr/bin:/bin NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 WD_PUBLIC_ORIGINS=@ORIGINS@ BIND_HOST=127.0.0.1 PORT=3000 AUTO_UPDATE=0 UPDATE_RESTART=0 /opt/webdesktop/app/node /opt/webdesktop/app/server.mjs
NoNewPrivileges=yes
CapabilityBoundingSet=
UMask=0077
Slice=webdesktop.slice
MemoryMax=384M
MemorySwapMax=128M
TasksMax=64
LimitNOFILE=1024
LimitCORE=0
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
