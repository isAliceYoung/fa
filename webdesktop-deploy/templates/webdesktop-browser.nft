table inet wd_browser {
 chain input {
  type filter hook input priority -50; policy accept;
  iifname "wdb-host" reject
 }
 chain forward {
  type filter hook forward priority -50; policy accept;
  iifname "wdb-host" meta nfproto ipv6 drop
  iifname "wdb-host" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } reject
  iifname "wdb-host" tcp dport { 80, 443 } accept
  iifname "wdb-host" udp dport 53 accept
  iifname "wdb-host" drop
  oifname "wdb-host" ct state established,related accept
  oifname "wdb-host" drop
 }
}
table ip wd_browser_nat {
 chain postrouting {
  type nat hook postrouting priority srcnat;
  ip saddr 10.232.0.2 masquerade
 }
}
