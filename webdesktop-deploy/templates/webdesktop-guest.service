[Unit]
Description=WebDesktop unprivileged guest files (3A)
Requires=webdesktop-guest.socket webdesktop-guest-state.service
After=webdesktop-guest.socket webdesktop-guest-state.service
RequiresMountsFor=/home/wdguest

[Service]
Type=simple
User=wdguest
Group=wdguest
WorkingDirectory=/home/wdguest
# Fixed, root-owned, read-only preflight. No user-supplied arguments or commands.
ExecStartPre=+/bin/bash /usr/local/lib/webdesktop-guest/check-ssh.sh
ExecStart=/usr/bin/env -i HOME=/home/wdguest USER=wdguest LOGNAME=wdguest LANG=C.UTF-8 PATH=/usr/bin:/bin /usr/bin/python3 -I -B /usr/local/lib/webdesktop-guest/agent.py
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/wdguest
ReadWritePaths=/home/wdguest
InaccessiblePaths=-/opt/webdesktop -/etc/webdesktop -/var/lib/webdesktop -/var/cache/webdesktop-build -/run/postgresql
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# This seccomp option denies ALL openat2 calls, including read-only opens.
# Keep openat2 path containment; NNP + empty capabilities prevent SUID gains.
RestrictSUIDSGID=no
SystemCallArchitectures=native
TasksMax=16
MemoryMax=96M
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
