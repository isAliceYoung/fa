// Only the trusted service UID may STOP two fixed unprivileged guest units.
// Never authorize StartUnit/StartTransientUnit, properties, unit files or root.
polkit.addRule(function(action, subject) {
    if (subject.user === 'wdsvc' && action.id.indexOf('org.freedesktop.systemd1.') === 0) {
        if (action.id === 'org.freedesktop.systemd1.manage-units' &&
            action.lookup('verb') === 'stop' &&
            (action.lookup('unit') === 'webdesktop-pty@1.service' || action.lookup('unit') === 'webdesktop-pty@2.service')) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});
