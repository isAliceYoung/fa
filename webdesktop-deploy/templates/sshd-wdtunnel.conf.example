# DESIGN ONLY: append this block INLINE at the END of the top-level sshd_config,
# after ALL global directives/Includes and existing Match blocks. Do not install
# in Debian's early sshd_config.d Include or Include it from a conditional Match.
# No global directives may follow this block. Validate the entire assembled file.
# Match all cannot restore the global parser section. No installation in 3A.
Match User wdtunnel
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AuthorizedKeysFile /etc/ssh/authorized_keys/wdtunnel
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:3000
    PermitListen none
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitTunnel no
    GatewayPorts no
    MaxSessions 0
    ForceCommand /usr/bin/false
